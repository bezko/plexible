{
    # Global options
}

# Replace with your hostname
:443 {
    tls internal
    
    reverse_proxy 127.0.0.1:32402 {
        # Strip forwarding headers that Plex uses to determine remote status
        header_up -X-Forwarded-For
        header_up -X-Forwarded-Host
        header_up -X-Forwarded-Proto
        header_up -X-Forwarded-Port
        header_up -Forwarded
        header_up -X-Real-IP
        header_up -X-Plex-Forwarded-For
        header_up -CF-Connecting-IP
        header_up -True-Client-IP
        
        # Strip headers that might reveal proxy usage
        header_up -Referer
        header_up -Origin
        
        # Ensure Host matches for Plex recognition
        header_up Host {http.request.host}
        
        # Rewrite Location headers
        header_down Location {http.request.scheme}://{http.request.host}/web/index.html
    }
}
